    "@medora/shared": "0.1.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "aws-amplify": "^6.22.2",
    "expo": "~52.0.46",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.5",
    "expo-location": "~18.0.10",
    "expo-router": "~4.0.20",
    "expo-splash-screen": "~0.29.22",
    "maplibre-gl": "5.24.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
