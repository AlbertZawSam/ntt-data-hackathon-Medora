    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "jest": "29.7.0",
    "jest-expo": "~52.0.5",
    "typescript": "~5.3.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
