{
  "name": "medora",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm run start -w @medora/frontend --",
    "web": "npm run web -w @medora/frontend --",
    "android": "npm run android -w @medora/frontend --",
    "ios": "npm run ios -w @medora/frontend --",
    "sandbox": "npm run sandbox -w @medora/backend --",
    "sandbox:delete": "npm run sandbox:delete -w @medora/backend --",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start:patient": "npm run start:patient -w @medora/frontend --",
    "start:hospital": "npm run start:hospital -w @medora/frontend --",
    "login": "aws sso login --profile medora",
    "design": "EXPO_PUBLIC_DESIGN_PREVIEW=1 npm run web",
    "seed": "bash scripts/with-aws.sh tsx scripts/seed.ts",
    "kb": "tsx scripts/build-kb.ts",
    "upload-kb": "bash scripts/with-aws.sh tsx scripts/upload-kb.ts",
    "evals": "bash scripts/with-aws.sh tsx scripts/run-evals.ts",
    "test-logins": "bash scripts/with-aws.sh node scripts/test-logins.mjs",
    "department-logins": "node scripts/test-logins.mjs --departments"
  }
}
